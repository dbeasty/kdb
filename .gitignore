# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ...except the Gradle wrapper jar itself: it's a checked-in bootstrap binary (what makes
# ./gradlew self-contained with no system Gradle install required), not build output - the blanket
# *.jar rule above was silently catching it too, so it was never actually committed and every CI
# job that runs ./gradlew (kotlin-test, integration, and go-test's Kotlin-interop smoke test) has
# been failing with "Could not find or load main class org.gradle.wrapper.GradleWrapperMain" since
# Phase 0 re-enabled the push/pull_request triggers that would have caught it.
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Gradle / KMP
**/build/
kdb-integration/e2e/.venv/
.gradle/
kotlin-js-store/
**/node_modules/

# Go
go/bin/
go/**/*.wasm
go/**/wasm_exec.js

# IDE
.DS_Store
.vscode/
**/bin/
