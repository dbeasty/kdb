{
  "name": "@limidus/kdb-embed",
  "version": "0.1.0",
  "description": "The KDB engine running in-process - Go compiled to WebAssembly, behind the @limidus/kdb-client operation set.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kdb.wasm": "./wasm/kdb.wasm",
    "./kdb.wasm.br": "./wasm/kdb.wasm.br"
  },
  "files": [
    "dist",
    "wasm",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-force-exit test/*.test.ts"
  },
  "dependencies": {
    "@limidus/kdb-client": "^0.1.0"
  },
  "devDependencies": {
    "@limidus/kdb-codegen": "file:../kdb-codegen",
    "@limidus/kdb-client": "file:../kdb-client",
    "@types/node": "^22.10.2",
    "typescript": "^5.9.2"
  }
}
