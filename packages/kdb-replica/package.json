{
  "name": "@kdb/replica",
  "version": "0.1.0",
  "description": "A client-side KDB replica: syncs namespaces with a KDB node over peer sync v2 and serves them locally.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "fixtures": "cd ../../go && go run ./cmd/kdb-tsfixtures"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.9.2"
  }
}
